---
import { LinkButton } from "@components/ui"
import { useTranslations } from "@lib/i18n"

import "./HeroSection.scss"

import photo from "@assets/images/profile-photo.jpg"

const t = await useTranslations(Astro.currentLocale)
const cvFileName = `CV - ${t("sections.hero.title")} - ${t("sections.hero.subtitle")}.pdf`
---

<section class="hero-section">
  <div class="container">
    <div class="hero-section__image">
      <img src={photo.src} alt={t("sections.hero.title")} width="320" height="320" />
    </div>
    <div class="hero-section__content">
      <hgroup>
        <h1>{t("sections.hero.title")}</h1>
        <h2>{t("sections.hero.subtitle")}</h2>
      </hgroup>
      <p>{t("sections.hero.description")}</p>
      <div class="hero-section__actions">
        <LinkButton
          className="primary"
          link={`mailto:${t("meta.email")}`}
          text={t("actions.getInTouch")}
        />
        <LinkButton
          className="contrast outline"
          downloadAs={cvFileName}
          link={"/files/cv.pdf"}
          text={t("actions.downloadCV")}
        />
      </div>
    </div>
  </div>
</section>
