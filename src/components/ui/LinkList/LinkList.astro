---
import type { ComponentProps, LinkData } from "@types"
import LinkButton from "../LinkButton/LinkButton.astro"

import "./LinkList.scss"

interface Props extends ComponentProps {
  items: Array<LinkData>
}

const { class: classList, items } = Astro.props
---

<ul class:list={[ "ui-link-list", classList ]}>
  {items.map((props) => (
    <li>
      <LinkButton {...props} class="contrast outline" />
    </li>
  ))}
</ul>
