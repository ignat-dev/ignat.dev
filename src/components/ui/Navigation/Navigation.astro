---
import type { ComponentProps, NavItem } from "@types"

import "./Navigation.scss"

interface Props extends ComponentProps {
  align?: "start" | "center" | "end"
  items: Array<NavItem>
}

const { align = "start", class: classList, id, items, theme } = Astro.props
const currentUrl = Astro.url.pathname
---

<nav class:list={[ "ui-navigation", classList ]} data-theme={theme} id={id}>
  <ul style={{ "--content-align": align }}>
    {items.map(({ label, url }) => (
      <li class:list={{ "is-active": url === currentUrl }}>
        <a href={url} aria-current={url === currentUrl || undefined}>
          <span>{label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>
