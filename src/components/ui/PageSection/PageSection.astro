---
import type { ComponentProps } from "@types"

import "./PageSection.scss"

interface Props extends ComponentProps {
  align?: "start" | "center" | "end"
  contentClass?: string
  footerClass?: string
  headerClass?: string
  maxWidth?: string
  title?: string
  text?: string
}

const {
  align = "start",
  class: classList,
  contentClass,
  footerClass,
  headerClass,
  id,
  maxWidth,
  title,
  text,
  theme,
} = Astro.props
const hasHeader = Boolean(Astro.slots.header || Astro.slots.title || title)
const hasFooter = Boolean(Astro.slots.footer)
---

<section
  class:list={[ "ui-page-section", classList ]}
  data-align={align}
  data-theme={theme}
  id={id}
  style={{
    "--content-align": align,
    "--max-width": maxWidth ?? undefined,
  }}
>
  {hasHeader && (
    <div class:list={[ "ui-page-section__header", headerClass ]}>
      {Astro.slots.header ? (
        <slot name="header" />
      ) : (
        <hgroup>
          {Astro.slots.title ? <slot name="title" /> : (title && <h2>{title}</h2>)}
          {Astro.slots.text ? <slot name="text" /> : (text && <p>{text}</p>)}
        </hgroup>
      )}
    </div>
  )}
  <div class:list={[ "ui-page-section__content", contentClass ]}>
    <slot />
  </div>
  {hasFooter && (
    <div class:list={[ "ui-page-section__footer", footerClass ]}>
      <slot name="footer" />
    </div>
  )}
</section>
