---
import "./PageSection.scss"

interface Props {
  align?: "left" | "center" | "right"
  className?: string
  contentClassName?: string
  footerClassName?: string
  headerClassName?: string
  maxWidth?: string
  title?: string
  text?: string
  theme?: "light" | "dark"
}

const {
  align = "center",
  className,
  contentClassName,
  footerClassName,
  headerClassName,
  maxWidth,
  title,
  text,
  theme,
} = Astro.props
const contentAlign = { left: "start", center: "center", right: "end" }[align]
const hasHeader = Boolean(Astro.slots.header || Astro.slots.title || title)
const hasFooter = Boolean(Astro.slots.footer)
---

<section
  class:list={[ "ui-page-section", className ]}
  data-align={align}
  data-theme={theme}
  style={{
    "--content-align": contentAlign,
    "--max-width": maxWidth ?? undefined,
  }}
>
  {hasHeader && (
    <div class:list={[ "ui-page-section__header", headerClassName ]}>
      {Astro.slots.header ? (
        <slot name="header" />
      ) : (
        <hgroup>
          {Astro.slots.title ? <slot name="title" /> : (title && <h2>{title}</h2>)}
          {Astro.slots.text ? <slot name="text" /> : (text && <p>{text}</p>)}
        </hgroup>
      )}
    </div>
  )}
  <div class:list={[ "ui-page-section__content", contentClassName ]}>
    <slot />
  </div>
  {hasFooter && (
    <div class:list={[ "ui-page-section__footer", footerClassName ]}>
      <slot name="footer" />
    </div>
  )}
</section>
